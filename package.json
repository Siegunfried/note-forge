{
  "name": "note-forge",
  "displayName": "Note Forge — 速记整理助手",
  "description": "用符号标记课堂速记，AI 自动补全成完整结构化笔记（DeepSeek / OpenAI 兼容接口）。",
  "version": "2.0.2",
  "publisher": "note-forge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "notes",
    "shorthand",
    "markdown",
    "ai",
    "deepseek",
    "organize"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noteForge.organize",
        "title": "整理当前笔记（补全）",
        "category": "Note Forge",
        "icon": "$(zap)"
      },
      {
        "command": "noteForge.create",
        "title": "新建速记",
        "category": "Note Forge",
        "icon": "$(add)"
      },
      {
        "command": "noteForge.openSettings",
        "title": "设置…",
        "category": "Note Forge",
        "icon": "$(gear)"
      },
      {
        "command": "noteForge.regenerate",
        "title": "重新生成",
        "category": "Note Forge",
        "icon": "$(refresh)"
      },
      {
        "command": "noteForge.reorder",
        "title": "重构章节树",
        "category": "Note Forge",
        "icon": "$(list-unordered)"
      },
      {
        "command": "noteForge.reorderRollback",
        "title": "回滚重构",
        "category": "Note Forge",
        "icon": "$(discard)"
      },
      {
        "command": "noteForge.importPdf",
        "title": "导入 PDF 生成速记",
        "category": "Note Forge",
        "icon": "$(file-pdf)"
      }
    ],
    "keybindings": [
      {
        "command": "noteForge.organize",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId =~ /^(markdown|plaintext|forge)$/"
      }
    ],
    "languages": [
      {
        "id": "forge",
        "extensions": [
          ".forge"
        ],
        "aliases": [
          "Note Forge 速记",
          "forge"
        ]
      }
    ],
    "configuration": {
      "title": "Note Forge",
      "properties": {
        "noteForge.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek / OpenAI 兼容的 API Key。留空时读环境变量 DEEPSEEK_API_KEY。"
        },
        "noteForge.apiBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/chat/completions",
          "description": "OpenAI 兼容的 chat/completions 地址。"
        },
        "noteForge.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "模型名（默认 deepseek-flash；质量优先可换 deepseek-v4-pro）。"
        },
        "noteForge.maxTokens": {
          "type": "number",
          "default": 16384,
          "description": "单次输出 token 上限（推理模型需预留推理 token）。"
        },
        "noteForge.temperature": {
          "type": "number",
          "default": 0.3,
          "description": "采样温度，整理任务偏确定，建议 0.3 左右。"
        },
        "noteForge.structureModel": {
          "type": "string",
          "default": "",
          "description": "PDF/文档结构化任务专用模型名；留空则复用 noteForge.model。"
        },
        "noteForge.ocrModel": {
          "type": "string",
          "default": "",
          "description": "扫描版文档的 OCR / 视觉模型名（第二期接入）；留空表示未配置该通道。"
        }
      }
    },
    "grammars": [
      {
        "language": "forge",
        "scopeName": "source.forge",
        "path": "./syntaxes/forge.tmLanguage.json"
      },
      {
        "scopeName": "inline.note-forge",
        "path": "./syntaxes/notes.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.plain"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noteForge",
          "title": "Note Forge",
          "icon": "media/note-forge.svg"
        }
      ]
    },
    "views": {
      "noteForge": [
        {
          "id": "noteForge.notes",
          "name": "笔记"
        },
        {
          "id": "noteForge.chapters",
          "name": "章节"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "noteForge.create",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.organize",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.importPdf",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.openSettings",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.regenerate",
          "when": "view == noteForge.chapters",
          "group": "navigation"
        },
        {
          "command": "noteForge.reorder",
          "when": "view == noteForge.chapters",
          "group": "navigation"
        },
        {
          "command": "noteForge.reorderRollback",
          "when": "view == noteForge.chapters",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/gen-grammar.js",
    "gen-grammar": "node scripts/gen-grammar.js",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/**/*.test.js\"",
    "package": "vsce package --baseContentUrl https://example.com/note-forge --baseImagesUrl https://example.com/note-forge"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
