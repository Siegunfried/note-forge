{
  "name": "note-forge",
  "displayName": "Note Forge — 速记整理助手",
  "description": "用符号标记课堂速记，AI 自动补全成完整结构化笔记（DeepSeek / OpenAI 兼容接口）。",
  "version": "0.3.0",
  "publisher": "note-forge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "notes",
    "shorthand",
    "markdown",
    "ai",
    "deepseek",
    "organize"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noteForge.organize",
        "title": "整理当前笔记（补全）",
        "category": "Note Forge"
      },
      {
        "command": "noteForge.create",
        "title": "新建速记",
        "category": "Note Forge",
        "icon": "$(add)"
      },
      {
        "command": "noteForge.organizeFile",
        "title": "整理",
        "category": "Note Forge"
      },
      {
        "command": "noteForge.openTarget",
        "title": "打开成品",
        "category": "Note Forge"
      },
      {
        "command": "noteForge.snapshot",
        "title": "更新快照",
        "category": "Note Forge"
      },
      {
        "command": "noteForge.openSettings",
        "title": "设置…",
        "category": "Note Forge",
        "icon": "$(gear)"
      },
      {
        "command": "noteForge.openDir",
        "title": "打开文件夹",
        "category": "Note Forge",
        "icon": "$(folder-opened)"
      },
      {
        "command": "noteForge.addFolder",
        "title": "添加文件夹",
        "category": "Note Forge",
        "icon": "$(folder-library)"
      },
      {
        "command": "noteForge.closeFolder",
        "title": "关闭此文件夹",
        "category": "Note Forge",
        "icon": "$(remove)"
      }
    ],
    "keybindings": [
      {
        "command": "noteForge.organize",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId =~ /^(markdown|plaintext|forge)$/"
      },
      {
        "command": "noteForge.snapshot",
        "key": "ctrl+shift+enter",
        "when": "editorTextFocus && editorLangId =~ /^(markdown|plaintext|forge)$/"
      }
    ],
    "languages": [
      {
        "id": "forge",
        "extensions": [
          ".forge"
        ],
        "aliases": [
          "Note Forge 速记",
          "forge"
        ]
      }
    ],
    "configuration": {
      "title": "Note Forge",
      "properties": {
        "noteForge.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek / OpenAI 兼容的 API Key。留空时读环境变量 DEEPSEEK_API_KEY。"
        },
        "noteForge.apiBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/chat/completions",
          "description": "OpenAI 兼容的 chat/completions 地址。"
        },
        "noteForge.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "模型名（DeepSeek V4：deepseek-v4-flash / deepseek-v4-pro）。"
        },
        "noteForge.maxTokens": {
          "type": "number",
          "default": 16384,
          "description": "单次输出 token 上限（推理模型需预留推理 token）。"
        },
        "noteForge.temperature": {
          "type": "number",
          "default": 0.3,
          "description": "采样温度，整理任务偏确定，建议 0.3 左右。"
        }
      }
    },
    "grammars": [
      {
        "language": "forge",
        "scopeName": "source.forge",
        "path": "./syntaxes/forge.tmLanguage.json"
      },
      {
        "scopeName": "inline.note-forge",
        "path": "./syntaxes/notes.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.plain"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noteForge",
          "title": "Note Forge",
          "icon": "media/note-forge.svg"
        }
      ]
    },
    "views": {
      "noteForge": [
        {
          "id": "noteForge.notes",
          "name": "笔记"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "noteForge.create",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.addFolder",
          "when": "view == noteForge.notes",
          "group": "navigation"
        },
        {
          "command": "noteForge.openSettings",
          "when": "view == noteForge.notes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "noteForge.organizeFile",
          "when": "viewItem == noteForge.forge",
          "group": "inline"
        },
        {
          "command": "noteForge.openTarget",
          "when": "viewItem == noteForge.forge",
          "group": "inline"
        },
        {
          "command": "noteForge.create",
          "when": "viewItem == noteForge.dir",
          "group": "inline"
        },
        {
          "command": "noteForge.openDir",
          "when": "viewItem == noteForge.dir",
          "group": "inline"
        },
        {
          "command": "noteForge.closeFolder",
          "when": "viewItem == noteForge.dir",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --baseContentUrl https://example.com/note-forge --baseImagesUrl https://example.com/note-forge"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
